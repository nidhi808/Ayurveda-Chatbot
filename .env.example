# AyurBot Environment Configuration

# Optional: Google Gemini API Key for online generation & live embeddings
# If left empty, AyurBot runs in local offline grounded synthesis mode
GEMINI_API_KEY=

# LLM Model Name
GEMINI_MODEL=gemini-2.5-flash

# Embeddings Model
EMBEDDING_MODEL=text-embedding-004

# Server Configuration
HOST=0.0.0.0
PORT=8000
